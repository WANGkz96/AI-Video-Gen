PORT=3001
WORKDIR=./data
JOBS_DIR=./data/jobs
ARCHIVE_DIR=./data/archives
TEMP_DIR=./data/tmp
LTX_RUNTIME_REPO_DIR=./data/runtime/ltx-2-official
MODELS_DIR=./models
GENERATOR_BACKEND=comfyui-ltx23
GENERATOR_API_URL=http://127.0.0.1:18188
COMFYUI_ROOT=/workspace/ComfyUI
COMFYUI_T2V_WORKFLOW=/workspace/ComfyUI/blueprints/Text to Video (LTX-2.3).json
COMFYUI_I2V_WORKFLOW=/workspace/ComfyUI/blueprints/Image to Video (LTX-2.3).json
COMFYUI_OUTPUT_PREFIX=video/AI_Video_Gen
COMFYUI_STRIP_AUDIO=0
COMFYUI_NORMALIZE_OUTPUT=0
AI_VIDEO_GEN_DOWNLOAD_COMFY_MODELS=0
AI_VIDEO_GEN_PROVISIONING_STATUS=./data/provisioning-status.json
AI_VIDEO_GEN_MODEL_DOWNLOAD_MAX_ATTEMPTS=60
AI_VIDEO_GEN_MODEL_DOWNLOAD_RETRY_DELAY=20
AI_VIDEO_GEN_MODEL_DOWNLOAD_CONCURRENCY=3
# Optional mounted path (for example Packet shared storage). Model payloads
# live here while runtimes remain on the instance. Leave empty to use the
# original ephemeral-only layout.
AI_VIDEO_GEN_PERSISTENT_MODEL_CACHE_DIR=
AI_VIDEO_GEN_BACKEND_READY_POLL_SEC=5
AI_VIDEO_GEN_BACKEND_READY_TIMEOUT_SEC=5400
AI_VIDEO_GEN_HF_BASE_URLS=https://huggingface.co,https://hf-mirror.com
ENABLE_LEGACY_BACKENDS=0
ENABLE_MOCK_BACKEND=0
MAX_PARALLEL_SEGMENTS=1
SEGMENT_VARIANTS=2
VIDEO_DURATION_SEC=8
VIDEO_FPS=25
PORTRAIT_RESOLUTION=720x1280
LANDSCAPE_RESOLUTION=1280x720
OUTPUT_UPSCALE=off
MOCK_MEDIA_DIR=./mock-media
HF_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_VIDEO_GEN_AUTH_REQUIRED=0
AI_VIDEO_GEN_API_TOKEN=
